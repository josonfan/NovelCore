APP_DEBUG = true
[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = novelcore
USERNAME = novelcore
PASSWORD = your_db_password_here
PREFIX = bl_
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true

[CACHE]
driver = redis
IS_CACHE = true
TTL = 3600

[REDIS]
HOST = 127.0.0.1
PORT = 6379
#PASSWORD = 12345
SELECT = 12
TIMEOUT = 0
EXPIRE = 0
PREFIX = bl_

[QUEUE]
DRIVER = redis

[JWT]
SECRET = 123456
ISSUER = novelcore
AUDIENCE = novelcore
LEEWAY = 5
TTL = 3600

[SITE]
NAME = BL文学子站A
CODE = bl_novel_a
BASE_API_URL = http://127.0.0.1:8080/api
PRIMARY_DOMAIN = http://127.0.0.1:8080
API_TOKEN = your_site_api_token_here
REMARK = 站点自动注册示例

[SERVER]
ADMIN_API_URL = https://admin.example.com/api
