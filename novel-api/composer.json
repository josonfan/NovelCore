{
    "name": "topthink/think",
    "description": "the new thinkphp framework - BL文学平台用户端接口服务",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM",
        "api",
        "jwt",
        "redis"
    ],
    "homepage": "https://www.thinkphp.cn/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "liu21st",
            "email": "liu21st@gmail.com"
        },
        {
            "name": "yunwuxin",
            "email": "448901948@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",        
        "firebase/php-jwt": "^6.10",
        "baiy/think-async": "^1.0",
        "predis/predis": "^2.2",
        "guzzlehttp/guzzle": "^7.8",
        "ramsey/uuid": "^4.7",
        "aws/aws-sdk-php": "^3.300",
        "topthink/think-throttle": "^2.0",
        "elasticsearch/elasticsearch": "8.7",
        "daniel-zahariev/php-aws-ses": "^0.9.5",
        "geoip2/geoip2": "~2.0"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0",
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
